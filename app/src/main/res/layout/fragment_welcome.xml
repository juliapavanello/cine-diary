<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cinza_claro">

    <!-- Área da imagem: o arredondamento é feito em cada ImageView (item_carrossel) -->
    <FrameLayout
        android:id="@+id/areaImagem"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/painelInferior">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/pagerCarrossel"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="64dp"
            android:text="@string/welcome_titulo"
            android:textColor="@color/preto"
            android:textSize="28sp"
            android:textStyle="bold" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabDots"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="16dp"
            android:background="@android:color/transparent"
            app:tabBackground="@drawable/selector_dot"
            app:tabGravity="start"
            app:tabIndicatorHeight="0dp"
            app:tabMaxWidth="14dp"
            app:tabMinWidth="14dp"
            app:tabMode="fixed"
            app:tabPaddingEnd="0dp"
            app:tabPaddingStart="0dp"
            app:tabRippleColor="@null" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/painelInferior"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="40dp"
        android:paddingTop="28dp"
        android:paddingBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_subtitulo"
            android:textColor="@color/preto"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEntrar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/preto"
            android:text="@string/entrar"
            android:textAllCaps="false"
            android:textColor="@color/branco"
            app:cornerRadius="6dp" />

        <TextView
            android:id="@+id/txtCriarConta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackground"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:padding="6dp"
            android:text="@string/ou_criar_conta"
            android:textColor="@color/preto"
            android:textStyle="bold"
            app:drawableEndCompat="@drawable/ic_seta_longa" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>