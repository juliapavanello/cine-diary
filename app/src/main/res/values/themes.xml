<resources>
    <style name="Theme.CineDiary" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/preto</item>
        <item name="colorOnPrimary">@color/branco</item>
        <item name="android:windowBackground">@color/fundo_escuro</item>
    </style>

    <!-- Card da imagem: só o canto inferior direito arredondado -->
    <style name="Forma.CantoInferiorDireito" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">56dp</item>
    </style>

    <!-- Avatar redondo -->
    <style name="Forma.Circulo" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Campos: caixa branca com texto preto -->
    <style name="Campo.Claro" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/campo_fundo</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
        <item name="android:textColorHint">@color/cinza_linha</item>
        <item name="hintTextColor">@color/preto</item>
        <item name="cursorColor">@color/preto</item>
        <item name="endIconTint">@color/preto</item>
    </style>

    <!-- Detalhes do filme -->
    <style name="Forma.Poster" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="Forma.Logo" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

    <style name="Detalhes.ColunaNota" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Detalhes.RotuloNota" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/branco</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Detalhes.ValorNota" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/branco</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Detalhes.TituloSecao" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:textColor">@color/branco</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
